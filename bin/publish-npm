#!/usr/bin/env bash

set -euo pipefail

readonly DIST_TAG="${NPM_DIST_TAG:-latest}"
readonly RELEASE_TAG="${RELEASE_TAG:-}"

publish_workspace() {
  local workspace="$1"
  local package_name
  local package_version
  local npm_info

  package_name="$(node -p "require('./${workspace}/package.json').name")"
  package_version="$(node -p "require('./${workspace}/package.json').version")"

  if [[ "$package_version" == "0.0.0" ]]; then
    echo "Refusing to publish ${package_name}@${package_version}. Release Please must set a release version first."
    return 1
  fi

  if npm_info="$(npm view "${package_name}@${package_version}" version --json 2>&1)"; then
    echo "${package_name}@${package_version} is already published; skipping."
    return 0
  fi

  if [[ "$npm_info" != *"E404"* ]]; then
    echo "Unable to check ${package_name}@${package_version} on npm:"
    echo "$npm_info"
    return 1
  fi

  echo "Publishing ${package_name}@${package_version} with dist-tag ${DIST_TAG}."
  npm publish --workspace "$package_name" --tag "$DIST_TAG"
}

case "$RELEASE_TAG" in
  "")
    publish_workspace "packages/player"
    publish_workspace "packages/player-react"
    # Manual runs can happen before analytics has its first Release Please version.
    if [[ "$(node -p "require('./packages/analytics/package.json').version")" != "0.0.0" ]]; then
      publish_workspace "packages/analytics"
    fi
    ;;
  player-v*)
    publish_workspace "packages/player"
    ;;
  player-react-v*)
    publish_workspace "packages/player-react"
    ;;
  analytics-v*)
    publish_workspace "packages/analytics"
    ;;
  *)
    echo "Unsupported release tag: ${RELEASE_TAG}"
    exit 1
    ;;
esac
