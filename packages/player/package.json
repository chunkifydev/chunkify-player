{
  "name": "@chunkify/player",
  "version": "1.4.1",
  "description": "Chunkify's portable video player Web Component",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chunkifydev/chunkify-player.git",
    "directory": "packages/player"
  },
  "homepage": "https://github.com/chunkifydev/chunkify-player#readme",
  "bugs": {
    "url": "https://github.com/chunkifydev/chunkify-player/issues"
  },
  "type": "module",
  "files": [
    "dist",
    "src",
    "THIRD_PARTY_NOTICES.md"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "hls-video-element": "~1.5.11",
    "media-chrome": "~4.19.2"
  }
}
