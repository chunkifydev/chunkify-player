{
  "name": "@chunkify/player-analytics",
  "version": "0.9.0",
  "description": "Standalone playback analytics for HTML media and Chunkify Player",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chunkifydev/chunkify-player.git",
    "directory": "packages/analytics"
  },
  "homepage": "https://github.com/chunkifydev/chunkify-player/tree/main/packages/analytics#readme",
  "bugs": {
    "url": "https://github.com/chunkifydev/chunkify-player/issues"
  },
  "type": "module",
  "files": [
    "dist",
    "src"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./chunkify": {
      "types": "./dist/chunkify.d.ts",
      "import": "./dist/chunkify.js"
    },
    "./datadog": {
      "types": "./dist/datadog.d.ts",
      "import": "./dist/datadog.js"
    },
    "./posthog": {
      "types": "./dist/posthog.d.ts",
      "import": "./dist/posthog.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "import": "./dist/http.js"
    },
    "./otlp": {
      "types": "./dist/otlp.d.ts",
      "import": "./dist/otlp.js"
    },
    "./player": {
      "types": "./dist/player.d.ts",
      "import": "./dist/player.js"
    },
    "./hlsjs": {
      "types": "./dist/hlsjs.d.ts",
      "import": "./dist/hlsjs.js"
    },
    "./videojs": {
      "types": "./dist/videojs.d.ts",
      "import": "./dist/videojs.js"
    },
    "./shaka": {
      "types": "./dist/shaka.d.ts",
      "import": "./dist/shaka.js"
    }
  },
  "peerDependencies": {
    "hls.js": "^1.6.5"
  },
  "peerDependenciesMeta": {
    "hls.js": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  }
}
