{
  "name": "@chunkify/analytics",
  "version": "0.0.0",
  "description": "Standalone playback analytics for HTML media and Chunkify Player",
  "license": "MIT",
  "type": "module",
  "files": ["dist", "src"],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./datadog": { "types": "./dist/datadog.d.ts", "import": "./dist/datadog.js" },
    "./posthog": { "types": "./dist/posthog.d.ts", "import": "./dist/posthog.js" },
    "./http": { "types": "./dist/http.d.ts", "import": "./dist/http.js" },
    "./player": { "types": "./dist/player.d.ts", "import": "./dist/player.js" },
    "./hlsjs": { "types": "./dist/hlsjs.d.ts", "import": "./dist/hlsjs.js" }
  },
  "peerDependencies": { "hls.js": "^1.6.5" },
  "peerDependenciesMeta": { "hls.js": { "optional": true } },
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  }
}
