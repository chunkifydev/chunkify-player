{
  "name": "@chunkify/player-react",
  "version": "1.2.2",
  "description": "Typed React wrapper for the Chunkify player Web Component",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chunkifydev/chunkify-player.git",
    "directory": "packages/player-react"
  },
  "homepage": "https://github.com/chunkifydev/chunkify-player#readme",
  "bugs": {
    "url": "https://github.com/chunkifydev/chunkify-player/issues"
  },
  "type": "module",
  "files": [
    "dist",
    "src"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@chunkify/player": "1.3.2"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}
