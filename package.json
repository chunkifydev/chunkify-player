{
  "name": "chunkify-player-workspace",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run build --workspace @chunkify/player && tsc --noEmit && npm run typecheck --workspaces",
    "serve": "http-server . -a 127.0.0.1 -p 4173 -c-1 --silent",
    "build:react-fixtures": "node scripts/build-react-fixtures.mjs",
    "test": "npm run build && node --test tests/server/*.test.mjs && npm run build:react-fixtures && playwright test",
    "check:package": "npm pack --workspaces --dry-run",
    "check": "npm run typecheck && npm test && npm run check:package",
    "release:publish": "bash ./bin/publish-npm"
  },
  "devDependencies": {
    "@playwright/test": "~1.63.0",
    "@types/node": "~24.13.5",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "esbuild": "~0.28.2",
    "http-server": "~14.1.1",
    "react": "~19.3.0",
    "react-dom": "~19.3.0",
    "typescript": "~7.0.2"
  }
}
